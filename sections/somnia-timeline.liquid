{%- comment -%} SOMNIA — timeline (two dates) {%- endcomment -%}
<section class="som-section som--{{ section.settings.theme }} som-timeline">
  <div class="som-wrap som-timeline__head">
    <div class="som-timeline__title">
      <div class="som-index som-reveal"><span class="lbl som-muted">{{ section.settings.index_label }}</span></div>
      <h2 class="som-reveal" data-delay="1">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url }}" class="som-link som-reveal" data-delay="2"><span class="dot"></span>{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="som-dates">
      {%- for block in section.blocks -%}
        <div class="som-date som-reveal" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.title }}</h4>
          <p class="som-muted">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Somnia timeline",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "theme", "label": "Theme", "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ], "default": "dark" },
    { "type": "text", "id": "index_label", "label": "Index label", "default": "The road" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two dates worth keeping" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Go to Love Machine" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "date",
      "name": "Date",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Presale — around August 2026" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Reservations open exclusively at somnia.love. The first run is limited to 1,000 units worldwide. Every deposit fully refundable, any time before delivery." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Somnia timeline",
      "blocks": [
        { "type": "date", "settings": { "title": "Presale — around August 2026", "body": "Reservations open exclusively at somnia.love. The first run is limited to 1,000 units worldwide. Every deposit fully refundable, any time before delivery." } },
        { "type": "date", "settings": { "title": "Q2 2027 — the day you meet her", "body": "First deliveries arrive in a plain box, with a neutral billing name. Discreet by default, always." } }
      ]
    }
  ]
}
{% endschema %}

