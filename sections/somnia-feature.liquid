{%- comment -%} SOMNIA — feature block (label + heading + body + link) {%- endcomment -%}
<section class="som-section som--{{ section.settings.theme }} som-feature">
  <div class="som-wrap som-feature__grid">
    <div class="som-feature__title">
      <div class="som-index som-reveal">
        <span class="num">{{ section.settings.index_num }}</span>
        <span class="lbl som-muted">{{ section.settings.index_label }}</span>
      </div>
      <h2 class="som-reveal" data-delay="1">{{ section.settings.heading }}</h2>
    </div>

    <div class="som-feature__body som-reveal" data-delay="1">
      {%- if section.settings.body != blank -%}<p class="som-muted">{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url }}" class="som-link"><span class="dot"></span>{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Somnia feature",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "theme", "label": "Theme", "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ], "default": "dark" },
    { "type": "text", "id": "index_num", "label": "Index number", "default": "1.0" },
    { "type": "text", "id": "index_label", "label": "Index label", "default": "Intelligence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "She reads the moment" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Local voice and visual sensing, processed on-device. She reads the moment, and sparks only the moments that matter — nothing leaves the room." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "How she protects you" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [ { "name": "Somnia feature" } ]
}
{% endschema %}

